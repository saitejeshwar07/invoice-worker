# Pick ONE provider (auto-detected from whichever key is set)
LLM_PROVIDER=openai          # openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Agent behaviour
HEADLESS=1                   # set 0 to watch the browser work
MAX_STEPS=40
APPROVAL_THRESHOLD=1000000   # INR; form submissions above this need human approval
FLAKY_FINANCE=1              # 1 = finance app fails the first submit of every new invoice (503)

# Ports / mock company credentials
DASHBOARD_PORT=8000
PORTAL_PORT=8001
FINANCE_PORT=8002
PORTAL_USER=ap.bot
PORTAL_PASS=portal123
